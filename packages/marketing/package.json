{
	"name": "@seaquel-app/marketing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm docs:update && pnpm og:generate && pnpm embed:build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"demo:update": "(rm -fr ./static/demo && cd ../../../../seaquel/ && npm run build:demo && cp -r ./build-demo ../seaquel-app/main/packages/marketing/static/demo)",
		"docs:update": "pnpm -C ../docs build && rm -rf ./static/docs && cp -r ../docs/dist ./static/docs",
		"og:generate": "tsx scripts/generate-blog-og.ts",
		"errors:update": "tsx scripts/fetch-sql-error-codes.ts",
		"embed:build": "vite build -c vite.embed.config.ts",
		"contacts:research": "wrangler d1 execute SEAQUEL_DB --remote --json --command \"SELECT email, source, unsubscribeToken, consentedAt FROM email_consents WHERE purpose='research' AND status='active' ORDER BY consentedAt DESC\"",
		"migrate:local": "wrangler d1 migrations apply SEAQUEL_DB --local",
		"migrate:prod": "wrangler d1 migrations apply SEAQUEL_DB --remote"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261006.1",
		"@electric-sql/pglite": "^0.5.8",
		"@fontsource/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.52.0",
		"@nerdfolio/remult-better-auth": "^0.4.3",
		"@noble/ed25519": "^3.2.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/opentype.js": "^1.3.10",
		"better-auth": "^1.7.7",
		"better-sqlite3": "^13.0.3",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"dodopayments-checkout": "^2.0.0",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"opentype.js": "1.3.4",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remult": "^3.3.18",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.3",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^5.0.3",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@resvg/resvg-wasm": "^2.6.2",
		"mdsvex": "^0.12.8",
		"satori": "^0.35.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
