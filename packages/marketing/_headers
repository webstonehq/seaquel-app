# The <seaquel-sql> embed loads cross-origin from other people's blogs, and
# module scripts, dynamic imports, and PGlite's WASM fetches all need CORS.
# Rules don't overlap: Cloudflare joins repeated headers with a comma.

# The name bloggers paste, so it can't carry a hash; keep its cache short.
/embed/seaquel-sql.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=3600

# Chunk names carry a content hash, so they never change in place.
/embed/chunks/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable
