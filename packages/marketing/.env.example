# ---------------------------------------------------------------------------
# Seaquel marketing / control plane — env vars
# ---------------------------------------------------------------------------
# Copy to `.env.local` for local `vite dev`. The same keys can be set as
# `wrangler secret put <KEY>` (or in `wrangler.jsonc.vars` for non-secrets)
# for deployed Cloudflare Workers.
#
# For `wrangler dev` specifically, use `.dev.vars` (copy `.dev.vars.example`).
# Same key names, different file — that's just how wrangler surfaces values
# via `event.platform.env` vs SvelteKit's `$env/dynamic/private`.
# ---------------------------------------------------------------------------

# ---- Better Auth ------------------------------------------------------------
# Cookie/session signing secret. Any sufficiently-random string works for dev;
# generate one via `openssl rand -base64 32` and set as a wrangler secret
# for prod.
BETTER_AUTH_SECRET=better-auth-dev-secret
# Canonical site URL. In prod this is set via wrangler.jsonc `vars`
# (currently "https://seaquel.app"). Only set here if overriding locally.
# BETTER_AUTH_URL=http://localhost:5173

# Comma-separated emails that automatically get the `super_admin` role on
# first sign-in. Leave empty in prod; used for bootstrapping in dev.
SUPER_ADMIN_EMAILS=

# ---- Cloud server-to-server auth -------------------------------------------
# Public URL of the control plane itself, embedded into every tenant
# container's env so it knows where to call back. Defaults to
# https://${CF_ROOT_DOMAIN}; set explicitly for local dev (e.g.
# http://localhost:5174).
SEAQUEL_CONTROL_URL=

# ---- DodoPayments -----------------------------------------------------------
# Dashboard: https://app.dodopayments.com
# Use your test key locally; live key lives only as a wrangler secret.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# "test" | "live" — controls which Dodo API host is called. Prod sets
# this to "live" via wrangler.jsonc.
DODO_MODE=test
# JSON map of Dodo product id → internal plan slug. Must match the
# products you've set up in Dodo. Overridden in prod via wrangler.jsonc.
PUBLIC_DODO_PRODUCT_MAP={"pdt_0NXwp6WmnGoTHWA7EjynU":"individual","pdt_0NXwpPGGHb3uvEIUrMO32":"business"}

# ---- Cloudflare DNS (control plane writes *.seaquel.app records) ------------
# REQUIRED in production. When unset in `vite dev` the DNS client falls
# back to a no-op mock so local flows work without credentials; in
# production, missing values throw at provision time.
#
# Token scope: Zone:DNS:Edit on the seaquel.app zone.
CF_API_TOKEN=
# Zone id for seaquel.app — find via `wrangler whoami` or CF dashboard.
CF_ZONE_ID=
# Optional override; defaults to "seaquel.app".
# CF_ROOT_DOMAIN=seaquel.app

# ---- Fly.io platform adapter ------------------------------------------------
# REQUIRED in production when POST /api/control/tenants is called with
# `platform: "fly"` (the default). When any of the three are unset in
# `vite dev`, a 2-second mock adapter is used so the flow is exercised
# end-to-end without real Fly credentials. In production, missing values
# throw at provision time.
#
# Org-scoped Fly API token with write access to apps + machines.
FLY_API_TOKEN=
# Fly org slug — each tenant gets its own app (seaquel-{slug}) in this org.
FLY_ORG=personal
# Container image ref for tenant containers.
FLY_IMAGE=ghcr.io/webstonehq/seaquel:latest

# ---- Cloudflare Containers (alternative platform) ---------------------------
# Only needed if you plan to POST with `platform: "cloudflare"`. Same
# dev/prod behavior as the Fly adapter above.
# CF_ACCOUNT_ID=
# CF_CONTAINER_IMAGE=ghcr.io/webstonehq/seaquel:latest

# ---- Air-gapped bundle signing ----------------------------------------------
# 32-byte Ed25519 seed (hex, with or without `0x` prefix). Required by
# `POST /api/control/airgap/bundle`. Generate with `openssl rand -hex 32`
# and set in prod via `wrangler secret put SEAQUEL_BUNDLE_SIGNING_PRIVATE_KEY`.
#
# Dev default below is the deterministic test seed from
# `bundle-signer.test.ts` — fine for local development, NEVER use in prod.
SEAQUEL_BUNDLE_SIGNING_PRIVATE_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
# Grace period (seconds) appended to currentPeriodEnd for the bundle
# `not_after`. Defaults to 2592000 (30 days) when unset.
# SEAQUEL_AIRGAP_GRACE_SECONDS=2592000

# ---------------------------------------------------------------------------
# Wrangler-only bindings — NOT set via this file
# ---------------------------------------------------------------------------
# These are bound by Cloudflare at deploy time and surfaced on
# `platform.env`. They're declared in wrangler.jsonc or set via
# `wrangler secret put`; listed here only so you know where to look.
#
#   SEAQUEL_DB                       D1 database (wrangler.jsonc → d1_databases)
#   GITHUB_API_CACHE                 KV namespace (wrangler.jsonc → kv_namespaces)
#   GITHUB_TOKEN                     wrangler secret — auth on updates check
#   GITHUB_TOKEN_FETCH_RELEASES_URL  wrangler secret — auth on download route
